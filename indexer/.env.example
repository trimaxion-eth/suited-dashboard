# Envio HyperIndex local environment (Robinhood Chain 4663)
# Copy to `.env` before running. The token authenticates the Envio HyperSync
# endpoint (robinhood.hypersync.xyz); it is not a wallet key. Get your own from
# https://envio.dev (free tier) — never commit a real token.
ENVIO_API_TOKEN=REPLACE_WITH_YOUR_ENVIO_TOKEN

# Optional RPC fallback only. HyperSync is the default data source.
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Optional: run a second indexer alongside another local Envio project without
# clobbering it. Uncomment to namespace this project's tables and metrics port.
# ENVIO_PG_SCHEMA=suited
# ENVIO_INDEXER_PORT=9899
